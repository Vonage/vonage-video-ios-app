    "start.recording.message" : {
      "comment" : "Message shown in an alert when the user taps the \"Start Recording\" button.\nWeb translation: recording.start.dialog.content (vonage-video-react-app develop 77c9b91).",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure everyone is ready! You can download the recording from the \"Goodbye\" page after you leave the room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Asegúrate de que todos estén listos! Puedes descargar la grabación desde la página de \"Despedida\" después de salir de la sala."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure everyone is ready! You can download the recording from the \"Goodbye\" page after you leave the room."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie sicher, dass alle bereit sind! Sie können die Aufzeichnung nach dem Verlassen des Raums von der Seite \"Auf Wiedersehen\" herunterladen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che tutti siano pronti! Puoi scaricare la registrazione dalla pagina \"Addio\" dopo aver lasciato la stanza."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Asegúrate que todos estén listos! Podrás descargar la grabación en la página de \"Despedida\" al salir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員の準備ができていることを確認してください！ ルームを退出した後、「さようなら」ページから録画をダウンロードできます。"
          }
        }
      }
    },
    "start.transcription.message" : {
      "comment" : "Message shown in an alert when the user taps the \"Start Transcription\" button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure everyone is ready! A transcript of the meeting will be generated and available after the call ends."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure everyone is ready! A transcript of the meeting will be generated and available after the call ends."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie sicher, dass alle bereit sind! Ein Transkript des Meetings wird erstellt und ist nach dem Ende des Anrufs verfügbar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che tutti siano pronti! Verrà generata una trascrizione della riunione, disponibile al termine della chiamata."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Asegúrate de que todos estén listos! Se generará una transcripción de la reunión que estará disponible una vez finalizada la llamada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Asegúrate de que todos estén listos! Se generará una transcripción de la reunión y estará disponible cuando termine la llamada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員の準備ができていることを確認してください。会議の文字起こしが生成され、通話終了後に利用できます。"
          }
        }
      }
    },
