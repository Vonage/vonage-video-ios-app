    "Mute %@ for everyone in the call? Only %@ can unmute themselves." : {
      "comment" : "Confirmation shown before force muting a participant. Both arguments are the participant name.\nWeb translation: participants.mute.dialog.content (vonage-video-react-app develop 77c9b91).",
