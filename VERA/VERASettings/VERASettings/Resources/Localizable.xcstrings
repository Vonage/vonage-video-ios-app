    "When enabled, you receive audio only from other participants during poor network conditions.": {
      "comment": "A footer description under the \"Subscriber Fallback\" toggle in the `AudioSectionView`.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está habilitado, recibes solo audio de otros participantes durante condiciones de red deficientes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, you receive audio only from other participants during poor network conditions."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, you receive audio only from other participants during poor network conditions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei schlechter Verbindung empfangen Sie von anderen Teilnehmern nur Audio, wenn diese Option aktiviert ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se attivato, ricevi solo l'audio degli altri partecipanti quando le condizioni della rete sono scarse."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si se activa, solo recibes el audio de los demás participantes cuando las condiciones de la red son deficientes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有効にすると、ネットワークの状態が悪い場合、他の参加者から音声のみを受信します。"
          }
        }
      }
    },
    "When enabled, your video stops rendering on other devices during poor network conditions to preserve audio.": {
      "comment": "A footer description for the \"Publisher Audio Fallback\" toggle.\nWeb translation: advancedSettings.audio.publisherAudioFallback.description (vonage-video-react-app develop 77c9b91).",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está habilitado, tu video deja de renderizarse en otros dispositivos durante condiciones de red deficientes para preservar el audio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, your video stops rendering on other devices during poor network conditions to preserve audio."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, your video stops rendering on other devices during poor network conditions to preserve audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird Ihr Video bei schlechter Netzwerkqualität auf anderen Geräten nicht mehr gerendert, um das Audio zu erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è abilitato, il tuo video smette di essere renderizzato su altri dispositivi durante condizioni di rete scarse per preservare l'audio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está habilitado, tu video deja de renderizarse en otros dispositivos durante condiciones de red deficientes para preservar el audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ネットワーク状況が悪い場合に、音声を保持するためにお客様のビデオが他のデバイスでのレンダリングを停止します。"
          }
        }
      }
    },
