    "Sends multiple quality layers so each viewer gets the best their connection allows. Applies the next time you start sharing.": {
      "comment": "Shared with VERA web: advancedSettings.video.scalableScreenshare.description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends multiple quality layers so each viewer gets the best their connection allows. Applies the next time you start sharing."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends multiple quality layers so each viewer gets the best their connection allows. Applies the next time you start sharing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet mehrere Qualitätsebenen, damit jeder Teilnehmer die beste für seine Verbindung erhält. Wird beim nächsten Start der Freigabe wirksam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia più livelli di qualità così ogni partecipante riceve il migliore consentito dalla sua connessione. Ha effetto la prossima volta che inizi a condividere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía varias capas de calidad para que cada participante reciba la mejor que permita su conexión. Se aplica la próxima vez que empieces a compartir."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía varias capas de calidad para que cada participante reciba la mejor que permita su conexión. Se aplica la próxima vez que empieces a compartir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の品質レイヤーを送信するため、各視聴者は接続状況に応じた最適な品質を受け取れます。次回画面共有を開始したときに適用されます。"
          }
        }
      }
    },
